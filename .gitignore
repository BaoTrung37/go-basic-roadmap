# Binaries for programs and plugins
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Runtime data
data/*.tmp

# IDE & OS files
.DS_Store
.idea/
.vscode/

# Explicitly track documentation (override global gitignore)
!docs/
!docs/**

